{
  "manifest_version": 3,
  "name": "Jarvis Bridge",
  "version": "1.1",
  "description": "Lets the local Jarvis assistant manage browser tabs and control YouTube.",
  "permissions": ["tabs", "alarms", "scripting", "storage"],
  "host_permissions": ["*://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["*://www.youtube.com/*"], "js": ["yt_content.js"], "run_at": "document_idle" }
  ]
}