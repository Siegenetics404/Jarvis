{
  "manifest_version": 3,
  "name": "Jarvis Bridge",
  "version": "1.3.1",
  "description": "Lets the local Jarvis assistant manage browser tabs and control YouTube.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Jarvis Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["tabs", "alarms", "scripting", "storage", "debugger"],
  "host_permissions": ["*://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["yt_content.js"],
      "run_at": "document_idle"
    }
  ]
}
